# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public (safe in browser)
NEXT_PUBLIC_SITE_URL=https://hunny-sindhakar.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # Firebase Analytics / GA4, e.g. G-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=                 # Microsoft Clarity project ID

# Server only (never expose)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                           # only needed locally for `pnpm db:migrate`
CRON_SECRET=                            # any long random string; Vercel Cron sends it automatically
REVALIDATE_SECRET=

# Optional — features stay off while empty
RESEND_API_KEY=                         # email alert for new contact messages
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=         # Cloudflare Turnstile spam protection
TURNSTILE_SECRET_KEY=

# Secret admin URL segment, e.g. studio-8f3k2q. The panel is served at /<value>; /admin returns 404.
NEXT_PUBLIC_ADMIN_PATH=
